# ==========================================================================
# LEARNER2DRIVER - HOSTINGER / APACHE / LITESPEED CONFIGURATION (.htaccess)
# ==========================================================================

# 1. Force index.html as the primary entry point (prevents serving residual index.php / AI builder files)
DirectoryIndex index.html

# 2. Disable Hostinger LiteSpeed Server Caching for HTML to ensure instant updates
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

<IfModule LiteSpeed>
    CacheDisable public /
    CacheDisable private /
</IfModule>

# 3. Ensure correct MIME Types
<IfModule mod_mime.c>
    AddType text/html .html .htm
    AddType text/css .css
    AddType application/javascript .js
    AddType application/json .json
    AddType image/svg+xml .svg
</IfModule>

# 4. Enable Gzip Compression for Performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# 5. Do not serve project files that are not part of the website
#    (docs, database scripts, build tooling). The whole repository is deployed
#    to public_html, so anything not blocked here is downloadable.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # One address for the site: www goes to the plain address (the Google key only answers for that one).
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
    RewriteRule \.(md|sql)$ - [F,L,NC]
    RewriteRule ^supabase/ - [F,L,NC]
    RewriteRule ^package(-lock)?\.json$ - [F,L,NC]
    RewriteRule ^\.gitignore$ - [F,L,NC]
    RewriteRule ^\.(hallmark|impeccable)/ - [F,L,NC]
</IfModule>

# 5b. Standard protections: always use HTTPS, do not guess file types, do not allow the
#     site inside another site's frame, send only the site address to other sites, and
#     ask for no device permissions.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Fonts and the map library do not change: keep them for a year.
    <FilesMatch "\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
</IfModule>

# 6. Scripts and styles: always check with the server before reusing a saved copy,
#    so an update to the site reaches returning visitors straight away.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
